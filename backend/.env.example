APP_NAME="Vinted IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vinted_ia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_TOKEN_LIMIT_FIELD=max_completion_tokens
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_DETAIL=auto
OPENAI_INPUT_COST_PER_MILLION=0.20
OPENAI_OUTPUT_COST_PER_MILLION=1.20

CREDITS_MONTHLY=50
CREDITS_ANALYSIS_COST=1
LISTING_MAX_PER_MINUTE=6
LISTING_DAILY_USER_COST_USD=1
LISTING_DAILY_GLOBAL_COST_USD=25
LISTING_MAX_INFLIGHT=1
LISTING_RESERVATION_TTL=180
LISTING_RESERVATION_HOLD_MICROS=20000

SANCTUM_EXPIRATION=43200

# false pendant l'installation privée. true lorsque le service est ouvert.
PUBLIC_REGISTRATION=true
CLIENT_API=true

# Compte(s) de test interne (adresses separees par des virgules) : acces meme si CLIENT_API=false, sans quota de credits.
# Vide = aucun. Voir docs/AUTOMATISATION-COMPTE-TEST.md.
TEST_ACCOUNT_EMAILS=

# Photos IA (fond studio, article porte par un mannequin) : POST /images/edits
OPENAI_IMAGE_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536
# high ou low, seulement si le modele l'accepte ; vide = parametre non envoye
OPENAI_IMAGE_INPUT_FIDELITY=
OPENAI_IMAGE_TIMEOUT=120
# Tarifs en dollars par million de jetons (page de prix OpenAI). A 0, le forfait ci-dessous s'applique.
OPENAI_IMAGE_INPUT_COST_PER_MILLION=0
OPENAI_IMAGE_OUTPUT_COST_PER_MILLION=0
OPENAI_IMAGE_FLAT_COST_USD=0.10
CREDITS_PHOTO_COST=5
PHOTO_MAX_PER_MINUTE=4
PHOTO_RESERVATION_HOLD_MICROS=100000
