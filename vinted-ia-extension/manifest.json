{
  "manifest_version": 3,
  "name": "Annonce Futée",
  "version": "1.5.0",
  "description": "Prépare les photos et l'annonce Vinted. Tu vérifies, tu remplis le formulaire, et tu publies toi-même.",
  "permissions": ["storage", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://*.vinted.net/*",
    "https://vinted.net/*",
    "https://*.vinted.fr/*",
    "https://vinted.fr/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://annoncefutee.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/*"],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Ouvrir Annonce Futée"
  }
}
