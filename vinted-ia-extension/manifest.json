{
  "manifest_version": 3,
  "name": "Annonce Futée",
  "version": "1.9.0",
  "description": "Prépare les photos et l'annonce Vinted. Tu vérifies, tu remplis le formulaire, et tu publies toi-même.",
  "permissions": ["storage", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://*.vinted.net/*",
    "https://vinted.net/*",
    "https://*.vinted.fr/*",
    "https://vinted.fr/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://annoncefutee.fr/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/*"],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Ouvrir Annonce Futée",
    "default_icon": {
      "16": "icons/icone-16.png",
      "32": "icons/icone-32.png",
      "48": "icons/icone-48.png",
      "128": "icons/icone-128.png"
    }
  },
  "icons": {
    "16": "icons/icone-16.png",
    "32": "icons/icone-32.png",
    "48": "icons/icone-48.png",
    "128": "icons/icone-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icone.png", "icons/logo.jpg"],
      "matches": ["https://www.vinted.fr/*", "https://*.vinted.fr/*"]
    }
  ]
}
